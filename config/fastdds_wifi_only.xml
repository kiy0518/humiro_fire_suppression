<?xml version="1.0" encoding="UTF-8" ?>
<!--
  메인 애플리케이션 전용 FastDDS 설정 (Domain 1)
  편대 토픽을 WiFi로만 전송. FC 통신은 fc_bridge (Domain 0, loopback)에서 처리.
  Generated by 003-apply_config.sh
-->
<dds>
    <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>wifi_only_udp</transport_id>
                <type>UDPv4</type>
                <interfaceWhiteList>
                    <address>192.168.100.11</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="participant_profile" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>wifi_only_udp</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
            </rtps>
        </participant>
    </profiles>
</dds>
